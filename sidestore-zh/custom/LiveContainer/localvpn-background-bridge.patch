 import Foundation
 import AppIntents
 import UserNotifications
+import NetworkExtension
 
 @available(iOS 17.0, *)
 func performIntentRefresh(identifier: String, mangledTypeName: String, intentProgress: Progress) async throws {
@@ -195,5 +196,41 @@ class RefreshHandler: NSObject, RefreshServer {
     func removePendingNotificationRequests(withIdentifiers identifiers: [String]) {
         UNUserNotificationCenter.current().removePendingNotificationRequests(withIdentifiers: identifiers)
     }
+
+    func startExistingLocalVPN(completion: @escaping (String?) -> Void) {
+        Task { @MainActor in
+            do {
+                guard let plugins = UserDefaults.lcMainBundle().builtInPlugInsURL,
+                      let bundle = Bundle(url: plugins.appendingPathComponent("LocalVPN.appex")),
+                      let id = bundle.bundleIdentifier else {
+                    throw NSError(domain: "SideStore.LocalVPN", code: 1,
+                                  userInfo: [NSLocalizedDescriptionKey: "安装包缺少 LocalVPN 扩展。"])
+                }
+                let managers = try await NETunnelProviderManager.loadAllFromPreferences()
+                guard let vpn = managers.first(where: {
+                    ($0.protocolConfiguration as? NETunnelProviderProtocol)?.providerBundleIdentifier == id
+                }), vpn.isEnabled else {
+                    throw NSError(domain: "SideStore.LocalVPN", code: 2,
+                                  userInfo: [NSLocalizedDescriptionKey: "请先打开 SideStore，在实验性功能中连接一次内置 VPN 并允许系统授权。"])
+                }
+                if vpn.connection.status != .connected && vpn.connection.status != .connecting && vpn.connection.status != .reasserting {
+                    try vpn.connection.startVPNTunnel()
+                }
+                let start = Date()
+                var connecting = false
+                while vpn.connection.status != .connected {
+                    let elapsed = Date().timeIntervalSince(start)
+                    connecting = connecting || vpn.connection.status == .connecting || vpn.connection.status == .reasserting
+                    if elapsed >= 20 || vpn.connection.status == .invalid ||
+                       (vpn.connection.status == .disconnected && (connecting || elapsed > 1)) {
+                        throw NSError(domain: "SideStore.LocalVPN", code: 3,
+                                      userInfo: [NSLocalizedDescriptionKey: "内置 VPN 无法连接，请检查签名中的 Network Extension 权限。"])
+                    }
+                    try await Task.sleep(nanoseconds: 200_000_000)
+                }
+                completion(nil)
+            } catch { completion(error.localizedDescription) }
+        }
+    }
     
 }
