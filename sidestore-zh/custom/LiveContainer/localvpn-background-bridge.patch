index 20d99527e750c76a6735bd7179e3955892da9427..10be25a0d98de047bbadb616c8e6e21adfa4ca0c 100644
--- a/SideStoreSupport/XPCClient.m
+++ b/SideStoreSupport/XPCClient.m
@@ -18,6 +18,35 @@ - (void)performRefreshForRealWithIdentifier:(NSString*)identifier
 @end
 
 static LiveProcessSideStoreHandler* handler = nil;
+
+// Called by SideStore's optional feature without linking its app to this framework.
+// NO means SideStore runs in the owning app and should use its own VPN controller.
+__attribute__((visibility("default")))
+BOOL LCSideStoreStartExistingLocalVPN(void (^completion)(NSString *)) {
+    if (!NSUserDefaults.isLiveProcess) return NO;
+    NSObject *gate = [NSObject new];
+    __block BOOL finished = NO;
+    void (^finishOnce)(NSString *) = ^(NSString *error) {
+        @synchronized (gate) {
+            if (finished) return;
+            finished = YES;
+        }
+        completion(error);
+    };
+    if (!handler.connection) {
+        finishOnce(@"内置 VPN 无法联系宿主，请先在普通模式打开 SideStore 并配置 VPN。");
+        return YES;
+    }
+    id<RefreshServer> server = [handler.connection remoteObjectProxyWithErrorHandler:^(NSError *error) {
+        finishOnce(error.localizedDescription);
+    }];
+    [server startExistingLocalVPNWithCompletion:finishOnce];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        finishOnce(@"内置 VPN 宿主响应超时，请打开 SideStore 检查 VPN 配置。");
+    });
+    return YES;
+}
+
 void installSideStoreHooks(void);
 
