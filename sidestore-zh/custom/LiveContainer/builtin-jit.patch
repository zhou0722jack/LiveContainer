     NSString *appError = nil;
+    if (isLiveProcess && !isSideStore && getenv("LC_BUILTIN_JIT_AWAIT")) {
+        unsetenv("LC_BUILTIN_JIT_AWAIT");
+        void *task = SecTaskCreateFromSelf(NULL);
+        CFTypeRef entitlement = task ? SecTaskCopyValueForEntitlement(task, CFSTR("get-task-allow"), NULL) : NULL;
+        BOOL allowed = entitlement == kCFBooleanTrue;
+        if (entitlement) CFRelease(entitlement);
+        if (task) CFRelease((CFTypeRef)task);
+        if (!allowed) return @"容器 LiveProcess 缺少 get-task-allow，请保留调试权限和扩展重新签名。";
+        BOOL attached = NO;
+        for (int attempt = 0; attempt < 1200; attempt++) {
+            int flags = 0;
+            if (csops(getpid(), 0, &flags, sizeof(flags)) == 0 && (flags & CS_DEBUGGED)) { attached = YES; break; }
+            usleep(100000);
+        }
+        if (!attached) return @"等待内置 JIT 调试器超时，请确认 Remote Pairing、LocalDevVPN 及辅助进程状态。";
+    }
     if([[lcUserDefaults objectForKey:@"LCWaitForDebugger"] boolValue]) {
         sleep(100);
     }
