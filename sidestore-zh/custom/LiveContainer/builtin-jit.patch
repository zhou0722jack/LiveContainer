+static NSString *startBuiltInJITForMain(NSDictionary *handoff, NSString *app, NSString *container) {
+    if (@available(iOS 17.4, *)) {} else { return @"内置 JIT 需要 iOS 17.4 或更新版本。"; }
+    void *task = SecTaskCreateFromSelf(NULL);
+    CFTypeRef entitlement = task ? SecTaskCopyValueForEntitlement(task, CFSTR("get-task-allow"), NULL) : NULL;
+    BOOL allowed = entitlement == kCFBooleanTrue;
+    if (entitlement) CFRelease(entitlement);
+    if (task) CFRelease((CFTypeRef)task);
+    if (!allowed) return @"宿主缺少 get-task-allow，请使用保留调试权限的方式签名。";
+    NSString *path = [lcMainBundle.bundlePath stringByAppendingPathComponent:@"Frameworks/SideStoreStikDebugCore.framework/SideStoreStikDebugCore"];
+    // Keep the framework mapped while the helper delivers late script results.
+    static void *core;
+    core = dlopen(path.fileSystemRepresentation, RTLD_NOW | RTLD_LOCAL);
+    if (!core) return @"无法加载内置 JIT 核心，请安装完整二合一包。";
+    NSString *(*start)(NSDictionary *, NSTimeInterval, BOOL (^)(void)) = dlsym(core, "SSStikDebugStartMainProcess");
+    if (!start) return @"内置 JIT 核心缺少全屏启动接口，请更新完整安装包。";
+    return start(@{ @"handoff": handoff, @"selectedApp": app ?: @"", @"selectedContainer": container ?: @"",
+        @"hostBundlePath": lcMainBundle.bundlePath, @"hostHome": @(getenv("LC_HOME_PATH")) }, 12.0, ^BOOL{
+        int flags = 0;
+        return csops(getpid(), 0, &flags, sizeof(flags)) == 0 && (flags & CS_DEBUGGED) != 0;
+    });
+}
