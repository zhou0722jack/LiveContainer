diff --git a/SideStore/Core/DeviceApi/BuiltInLocalVPN.swift b/SideStore/Core/DeviceApi/BuiltInLocalVPN.swift
new file mode 100644
index 0000000000000000000000000000000000000000..21f106b1900b61b39f51398361df2bbcdf575e70
--- /dev/null
+++ b/SideStore/Core/DeviceApi/BuiltInLocalVPN.swift
@@ -0,0 +1,169 @@
+import Combine
+import Darwin
+import Foundation
+import NetworkExtension
+import UIKit
+
+/// Controls the extension installed in the real app, including the LiveContainer host.
+@MainActor
+final class BuiltInLocalVPN: ObservableObject {
+    static let shared = BuiltInLocalVPN()
+    static let refreshKey = "BuiltInLocalVPNAutoRefresh"
+    static let launchKey = "BuiltInLocalVPNAutoLaunch"
+    static let deviceIPKey = "BuiltInLocalVPNDeviceIP"
+    static let peerIPKey = "BuiltInLocalVPNPeerIP"
+
+    @Published private(set) var status = "未连接"
+    @Published private(set) var lastError: String?
+    @Published private(set) var isBusy = false
+    private var manager: NETunnelProviderManager?
+    private var connectionTask: Task<Void, Error>?
+    private var observer: NSObjectProtocol?
+
+    private init() {
+        observer = NotificationCenter.default.addObserver(forName: .NEVPNStatusDidChange,
+                                                         object: nil, queue: .main) { [weak self] _ in
+            Task { @MainActor in self?.updateStatus() }
+        }
+    }
+
+    private var providerID: String? {
+        // Bundle.main is SideStore's framework while running inside LiveContainer.
+        // activeBundle is already redirected by SideStoreSupport to the real host.
+        guard let plugins = Bundle.Info.activeBundle.builtInPlugInsURL,
+              let bundle = Bundle(url: plugins.appendingPathComponent("LocalVPN.appex")) else { return nil }
+        return bundle.bundleIdentifier
+    }
+
+    func startOnLaunchIfEnabled() async {
+        guard UserDefaults.standard.bool(forKey: Self.launchKey) else { return }
+        do { try await connect() } catch { /* Error is visible in Experimental Features. */ }
+    }
+
+    func startBeforeRefreshIfEnabled() async throws {
+        guard UserDefaults.standard.bool(forKey: Self.refreshKey) else { return }
+        // Shortcut refreshes run SideStore in LiveProcess. Only the owning app
+        // can manage its VPN configuration, so ask it over the existing XPC channel.
+        if try await startViaHostIfNeeded() { return }
+        try await connect()
+    }
+
+    private func startViaHostIfNeeded() async throws -> Bool {
+        let path = Bundle.Info.activeBundle.bundleURL.appendingPathComponent("Frameworks/SideStoreSupport.framework/SideStoreSupport").path
+        guard let handle = dlopen(path, RTLD_LAZY | RTLD_NOLOAD) else { return false }
+        defer { dlclose(handle) }
+        guard let symbol = dlsym(handle, "LCSideStoreStartExistingLocalVPN") else { return false }
+        typealias Bridge = @convention(c) (@convention(block) (NSString?) -> Void) -> Bool
+        let bridge = unsafeBitCast(symbol, to: Bridge.self)
+        return try await withCheckedThrowingContinuation { continuation in
+            let routed = bridge { error in
+                if let error { continuation.resume(throwing: NSError(domain: "SideStore.LocalVPN", code: 3,
+                                                                      userInfo: [NSLocalizedDescriptionKey: error as String])) }
+                else { continuation.resume(returning: true) }
+            }
+            if !routed { continuation.resume(returning: false) }
+        }
+    }
+
+    func reloadStatus() async {
+        guard !isBusy, let id = providerID else { return }
+        do {
+            let managers = try await NETunnelProviderManager.loadAllFromPreferences()
+            manager = managers.first { ($0.protocolConfiguration as? NETunnelProviderProtocol)?.providerBundleIdentifier == id }
+            updateStatus()
+        } catch { lastError = error.localizedDescription }
+    }
+
+    func connect() async throws {
+        if let task = connectionTask { return try await task.value }
+        let task = Task { try await self.establishConnection() }
+        connectionTask = task
+        isBusy = true
+        lastError = nil
+        defer { connectionTask = nil; isBusy = false; updateStatus() }
+        do { try await task.value }
+        catch {
+            lastError = "内置 VPN 启动失败：\(error.localizedDescription)"
+            throw NSError(domain: "SideStore.LocalVPN", code: 1,
+                          userInfo: [NSLocalizedDescriptionKey: lastError!])
+        }
+    }
+
+    private func establishConnection() async throws {
+        guard let id = providerID else {
+            throw failure("安装包缺少 LocalVPN 扩展，请重新安装完整的二合一包。")
+        }
+        let managers = try await NETunnelProviderManager.loadAllFromPreferences()
+        let existing = managers.first { ($0.protocolConfiguration as? NETunnelProviderProtocol)?.providerBundleIdentifier == id }
+        let vpn = existing ?? NETunnelProviderManager()
+        manager = vpn
+        if vpn.connection.status == .connected { return }
+        if vpn.connection.status != .connecting && vpn.connection.status != .reasserting {
+            guard vpn.connection.status != .disconnecting else {
+                throw failure("VPN 正在断开，请稍后重试。")
+            }
+            let device = UserDefaults.standard.string(forKey: Self.deviceIPKey) ?? "10.7.0.0"
+            let peer = UserDefaults.standard.string(forKey: Self.peerIPKey) ?? "10.7.0.1"
+            guard Self.isIPv4(device), Self.isIPv4(peer), device != peer else {
+                throw failure("隧道地址和对端地址必须是两个不同的有效 IPv4 地址。")
+            }
+            let proto = NETunnelProviderProtocol()
+            proto.providerBundleIdentifier = id
+            proto.serverAddress = "SideStore LocalVPN"
+            proto.providerConfiguration = ["TunnelDeviceIP": device, "TunnelFakeIP": peer]
+            let old = vpn.protocolConfiguration as? NETunnelProviderProtocol
+            let needsSave = existing == nil || !vpn.isEnabled || old?.providerConfiguration?["TunnelDeviceIP"] as? String != device || old?.providerConfiguration?["TunnelFakeIP"] as? String != peer
+            if needsSave {
+                guard UIApplication.shared.applicationState == .active else {
+                    throw failure("请先打开 SideStore，在实验性功能中连接一次并允许添加 VPN 配置，再使用后台刷新。")
+                }
+                vpn.protocolConfiguration = proto
+                vpn.localizedDescription = "SideStore 内置 LocalVPN"
+                vpn.isEnabled = true
+                // Automatic startup is controlled by the two explicit preferences.
+                vpn.isOnDemandEnabled = false
+                try await vpn.saveToPreferences()
+                try await vpn.loadFromPreferences()
+            }
+            status = "正在连接"
+            try vpn.connection.startVPNTunnel()
+        }
+        // Starting the extension is asynchronous; do not race Minimuxer's readiness check.
+        let startedAt = Date()
+        let deadline = Date().addingTimeInterval(20)
+        var observedConnecting = false
+        while vpn.connection.status != .connected {
+            try Task.checkCancellation()
+            guard Date() < deadline else { throw failure("连接超时，请检查 VPN 权限和签名后重试。") }
+            observedConnecting = observedConnecting || vpn.connection.status == .connecting || vpn.connection.status == .reasserting
+            if vpn.connection.status == .invalid ||
+               (vpn.connection.status == .disconnected && (observedConnecting || Date().timeIntervalSince(startedAt) > 1)) {
+                throw failure("隧道未能连接，请确认签名包含 Network Extension 权限。")
+            }
+            try await Task.sleep(nanoseconds: 200_000_000)
+        }
+    }
+
+    func disconnect() {
+        guard !isBusy else { return }
+        manager?.connection.stopVPNTunnel()
+    }
+
+    private func updateStatus() {
+        switch manager?.connection.status ?? .disconnected {
+        case .connected: status = "已连接"
+        case .connecting, .reasserting: status = "正在连接"
+        case .disconnecting: status = "正在断开"
+        default: status = "未连接"
+        }
+    }
+
+    private static func isIPv4(_ value: String) -> Bool {
+        let parts = value.split(separator: ".", omittingEmptySubsequences: false)
+        return parts.count == 4 && parts.allSatisfy { !$0.isEmpty && $0.allSatisfy(\.isNumber) && UInt8($0) != nil }
+    }
+
+    private func failure(_ message: String) -> NSError {
+        NSError(domain: "SideStore.LocalVPN", code: 2, userInfo: [NSLocalizedDescriptionKey: message])
+    }
+}
