+private struct BuiltInLocalVPNSettingsView: View {
+    @ObservedObject private var vpn = BuiltInLocalVPN.shared
+    @AppStorage(BuiltInLocalVPN.deviceIPKey) private var deviceIP = "10.7.0.0"
+    @AppStorage(BuiltInLocalVPN.peerIPKey) private var peerIP = "10.7.0.1"
+
+    var body: some View {
+        SwiftUI.Form {
+            SwiftUI.Section(header: Text("连接"), footer: Text("VPN 启动失败会停止自动刷新，并显示原因。后台首次使用前，请先在此连接一次并允许系统授权。其他 VPN 可能被系统断开。")) {
+                HStack { Text("连接状态"); Spacer(); Text(vpn.status) }
+                SwiftUI.Button("连接内置 VPN") { Task { try? await vpn.connect() } }
+                    .disabled(vpn.isBusy)
+                SwiftUI.Button("断开内置 VPN", role: .destructive) { vpn.disconnect() }
+                    .disabled(vpn.isBusy)
+                if let error = vpn.lastError { Text(error).foregroundColor(.orange) }
+            }
+            SwiftUI.Section(header: Text("隧道地址"), footer: Text("默认 10.7.0.0 / 10.7.0.1。使用 /32 地址和对端路由，不接管整个局域网。iOS 26.4 及以上若出现子网限制，请按当前网络配置两个可用的同子网地址。修改后需断开再连接。")) {
+                TextField("隧道 IPv4 地址", text: $deviceIP)
+                TextField("对端 IPv4 地址", text: $peerIP)
+            }
+            .keyboardType(.numbersAndPunctuation)
+            .disableAutocorrection(true)
